// demo2.rc — demo2 应用资源：图标 + 清单 + 版本信息（v2.0.0-alpha）
#include <windows.h>

APPICON ICON "assets/icon.ico"
IDI_ICON1 ICON "assets/icon.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "HScreenFilter"
            VALUE "FileDescription", "HScreenFilter v2.0.0-alpha (WebView2)"
            VALUE "FileVersion", "2.0.0-alpha"
            VALUE "InternalName", "HScreenFilter"
            VALUE "OriginalFilename", "webview2_demo2.exe"
            VALUE "ProductName", "HScreenFilter 屏幕滤镜"
            VALUE "ProductVersion", "2.0.0-alpha"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
