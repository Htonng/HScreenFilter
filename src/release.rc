// release.rc — 发布版应用资源：图标 + 清单 + 版本信息
#include <windows.h>
#include "version.h"

APPICON ICON "assets/icon.ico"
IDI_ICON1 ICON "assets/icon.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HSF_VERSION_NUM
 PRODUCTVERSION HSF_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "HScreenFilter"
            VALUE "FileDescription", "HScreenFilter 屏幕滤镜 " HSF_VERSION_STR
            VALUE "FileVersion", HSF_VERSION_STR
            VALUE "InternalName", "HScreenFilter"
            VALUE "OriginalFilename", "HScreenFilter.exe"
            VALUE "ProductName", "HScreenFilter 屏幕滤镜"
            VALUE "ProductVersion", HSF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
