// release.rc — 发布版应用资源：图标 + 清单 + 版本信息（v2.0.0-beta）
#include <windows.h>

APPICON ICON "assets/icon.ico"
IDI_ICON1 ICON "assets/icon.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "HScreenFilter"
            VALUE "FileDescription", "HScreenFilter 屏幕滤镜 v2.0.0-beta"
            VALUE "FileVersion", "2.0.0-beta"
            VALUE "InternalName", "HScreenFilter"
            VALUE "OriginalFilename", "HScreenFilter.exe"
            VALUE "ProductName", "HScreenFilter 屏幕滤镜"
            VALUE "ProductVersion", "2.0.0-beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
