<Window
    x:Class="HScreenFilter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HScreenFilter.Controls"
    Title="HScreenFilter">

    <!-- 整页滚动：窗口较小时可上下滚动查看全部内容（滑块 + 配置 + 开机自启） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ZoomMode="Disabled">
        <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown" IsTabStop="True"
              UseSystemFocusVisuals="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏（毛玻璃可拖动区域，右侧留给系统按钮） ============ -->
            <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="16,0,150,0" Background="Transparent">
                <TextBlock Text="屏幕滤镜" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
            </Grid>

            <!-- ============ 头部 ============ -->
            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="24,4,24,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="HScreenFilter" Style="{StaticResource TitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Text="正在初始化…"/>
                        <HyperlinkButton x:Name="DebugLogButton" Content="调试日志" FontSize="11"
                                         VerticalAlignment="Center" Click="DebugLogButton_Click"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="EnableSwitch" Header="启用滤镜"
                                     OnContent="已启用" OffContent="已关闭"
                                     Toggled="EnableSwitch_Toggled" Margin="0,4,0,0"/>
                        <Border x:Name="GlobalHotkeyBadge" Grid.Column="1"
                               Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                               CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Visibility="Collapsed">
                           <StackPanel Orientation="Horizontal" Spacing="6">
                               <TextBlock Text="全局开关" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                               <TextBlock x:Name="GlobalHotkeyText" FontSize="11" FontWeight="SemiBold"/>
                           </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 滑块与预设 ============ -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="24,4,24,8" Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,16"
                                Margin="0,0,0,12">
                           <StackPanel Spacing="12">
                               <StackPanel Orientation="Horizontal" Spacing="8">
                                   <Border Width="4" Height="18" CornerRadius="2" VerticalAlignment="Center"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                   <StackPanel Spacing="4">
                                       <TextBlock Text="基础调节" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                       <TextBlock Text="拖动滑块即可实时调整滤镜的亮度、对比度、色彩和阴影表现。"
                                                  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                   </StackPanel>
                               </StackPanel>
                               <StackPanel Spacing="12">
                                   <controls:FilterSlider x:Name="BrightnessSlider" Header="亮度 Brightness" Minimum="-100" Maximum="100"/>
                                   <controls:FilterSlider x:Name="ContrastSlider" Header="对比度 Contrast" Minimum="0" Maximum="200"/>
                                   <controls:FilterSlider x:Name="SaturationSlider" Header="鲜艳度 Saturation" Minimum="0" Maximum="200"/>
                                   <controls:FilterSlider x:Name="HighlightSlider" Header="亮部 Highlights" Minimum="-100" Maximum="100"/>
                                   <controls:FilterSlider x:Name="ShadowSlider" Header="暗部 Shadows" Minimum="-100" Maximum="100"/>
                                   <controls:FilterSlider x:Name="TemperatureSlider" Header="色温（冷 ← → 暖）" Minimum="-100" Maximum="100"/>
                               </StackPanel>

                               <StackPanel Spacing="8">
                                   <TextBlock Text="快捷预设" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                   <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Button Content="标准" Click="PresetStandard_Click"/>
                                       <Button Content="护眼" Click="PresetEyeCare_Click"/>
                                       <Button Content="夜间" Click="PresetNight_Click"/>
                                       <Button Content="鲜艳" Click="PresetVivid_Click"/>
                                   </StackPanel>
                               </StackPanel>
                           </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,16"
                                Margin="0,0,0,12">
                           <StackPanel Spacing="12">
                               <StackPanel Spacing="4">
                                   <TextBlock Text="🎨 HSL 调色盘" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                   <TextBlock Text="像 Photoshop 一样，按色系分别精细调整色相、饱和度、明亮度，各色系互不干扰。"
                                              FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                               </StackPanel>

                               <!-- DXGI 引擎开关：开启才能使用 HSL 调色（关闭用放大镜 API，HSL 不可用） -->
                               <ToggleSwitch x:Name="DxgiSwitch" Header="DXGI 引擎开关"
                                             OnContent="DXGI 开启（支持 HSL）" OffContent="DXGI 关闭（放大镜引擎）"
                                             Toggled="DxgiSwitch_Toggled"/>

                               <!-- 色相 / 饱和度 / 明亮度 三个子区域，各 8 个色系 + 全部(主) -->
                               <Pivot x:Name="HslPivot" Margin="0,0,0,4">
                                   <!-- 色相（各色系微调 ±60°：两端极值 = 相邻两个色系的颜色，中间 = 本色系） -->
                                   <PivotItem Header="色相">
                                       <StackPanel Spacing="10" Margin="0,8,0,0">
                                           <controls:FilterSlider x:Name="HueMasterSlider" Header="全部（主）" Minimum="-180" Maximum="180"
                                                                  Spectrum="#FF0000,#FF8000,#FFFF00,#00FF00,#00FFFF,#0000FF,#8000FF,#FF00FF,#FF0000"/>
                                           <!-- 各色系色相统一 ±30° 微调 -->
                                           <controls:FilterSlider x:Name="HueRedSlider" Header="红" Minimum="-30" Maximum="30"
                                                                  Spectrum="#FF00FF,#FF0000,#FF8000"/>
                                           <controls:FilterSlider x:Name="HueOrangeSlider" Header="橙" Minimum="-30" Maximum="30"
                                                                  Spectrum="#FF0000,#FF8000,#FFFF00"/>
                                           <controls:FilterSlider x:Name="HueYellowSlider" Header="黄" Minimum="-30" Maximum="30"
                                                                  Spectrum="#FF8000,#FFFF00,#00FF00"/>
                                           <controls:FilterSlider x:Name="HueGreenSlider" Header="绿" Minimum="-30" Maximum="30"
                                                                  Spectrum="#FFFF00,#00FF00,#00FFFF"/>
                                           <controls:FilterSlider x:Name="HueCyanSlider" Header="青" Minimum="-30" Maximum="30"
                                                                  Spectrum="#00FF00,#00FFFF,#0000FF"/>
                                           <controls:FilterSlider x:Name="HueBlueSlider" Header="蓝" Minimum="-30" Maximum="30"
                                                                  Spectrum="#00FFFF,#0000FF,#8000FF"/>
                                           <controls:FilterSlider x:Name="HuePurpleSlider" Header="紫" Minimum="-30" Maximum="30"
                                                                  Spectrum="#0000FF,#8000FF,#FF00FF"/>
                                           <controls:FilterSlider x:Name="HueMagentaSlider" Header="品红" Minimum="-30" Maximum="30"
                                                                  Spectrum="#8000FF,#FF00FF,#FF0000"/>
                                       </StackPanel>
                                   </PivotItem>

                                   <!-- 饱和度（灰 → 本色） -->
                                   <PivotItem Header="饱和度">
                                       <StackPanel Spacing="10" Margin="0,8,0,0">
                                           <controls:FilterSlider x:Name="SatMasterSlider" Header="全部（主）" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#FF0000"/>
                                           <controls:FilterSlider x:Name="SatRedSlider" Header="红" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#FF0000"/>
                                           <controls:FilterSlider x:Name="SatOrangeSlider" Header="橙" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#FF8000"/>
                                           <controls:FilterSlider x:Name="SatYellowSlider" Header="黄" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#FFFF00"/>
                                           <controls:FilterSlider x:Name="SatGreenSlider" Header="绿" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#00FF00"/>
                                           <controls:FilterSlider x:Name="SatCyanSlider" Header="青" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#00FFFF"/>
                                           <controls:FilterSlider x:Name="SatBlueSlider" Header="蓝" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#0000FF"/>
                                           <controls:FilterSlider x:Name="SatPurpleSlider" Header="紫" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#8000FF"/>
                                           <controls:FilterSlider x:Name="SatMagentaSlider" Header="品红" Minimum="0" Maximum="200"
                                                                  Spectrum="#808080,#FF00FF"/>
                                       </StackPanel>
                                   </PivotItem>

                                   <!-- 明亮度（黑 → 灰 → 白，范围 -10..10 微调） -->
                                   <PivotItem Header="明亮度">
                                       <StackPanel Spacing="10" Margin="0,8,0,0">
                                           <controls:FilterSlider x:Name="LightMasterSlider" Header="全部（主）" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightRedSlider" Header="红" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightOrangeSlider" Header="橙" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightYellowSlider" Header="黄" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightGreenSlider" Header="绿" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightCyanSlider" Header="青" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightBlueSlider" Header="蓝" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightPurpleSlider" Header="紫" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                           <controls:FilterSlider x:Name="LightMagentaSlider" Header="品红" Minimum="-10" Maximum="10"
                                                                  Spectrum="#000000,#808080,#FFFFFF"/>
                                       </StackPanel>
                                   </PivotItem>
                               </Pivot>

                               <StackPanel Orientation="Horizontal" Spacing="8">
                                   <Button Content="默认值" Click="HslReset_Click"/>
                               </StackPanel>

                               <TextBlock x:Name="HslChannelHint" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="提示：当前为整屏单矩阵，具体色系的调整是对全局的近似模拟，主次效果按所选色系体现。"/>
                           </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,16"
                                Margin="0,0,0,12">
                           <StackPanel Spacing="10">
                               <StackPanel Orientation="Horizontal" Spacing="8">
                                   <Border Width="4" Height="18" CornerRadius="2" VerticalAlignment="Center"
                                           Background="#1F9E6C"/>
                                   <StackPanel Spacing="4">
                                       <TextBlock Text="按应用切换滤镜" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                       <TextBlock Text="让滤镜只在指定应用前台时启用，切到其它窗口时自动关闭。"
                                                  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                   </StackPanel>
                               </StackPanel>
                               <ToggleSwitch x:Name="PerAppSwitch" Header="启用按应用切换"
                                             OnContent="已启用" OffContent="已关闭"
                                             Toggled="PerAppSwitch_Toggled"/>
                               <ListView x:Name="AppBindingList" Height="132" SelectionMode="None" Margin="0,4,0,0">
                                   <ListView.ItemTemplate>
                                       <DataTemplate>
                                           <Grid ColumnSpacing="10" Padding="0,4">
                                               <Grid.ColumnDefinitions>
                                                   <ColumnDefinition Width="*"/>
                                                   <ColumnDefinition Width="Auto"/>
                                                   <ColumnDefinition Width="Auto"/>
                                               </Grid.ColumnDefinitions>
                                               <StackPanel Spacing="2" VerticalAlignment="Center">
                                                   <TextBlock Text="{Binding DisplayName}"/>
                                                   <TextBlock Text="{Binding ProfileDisplay}" FontSize="11"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                               </StackPanel>
                                               <Button Grid.Column="1" Content="编辑" FontSize="11" Padding="8,4"
                                                       Click="EditBinding_Click"/>
                                               <Button Grid.Column="2" Content="删除" FontSize="11" Padding="8,4"
                                                       Click="DeleteBinding_Click"/>
                                           </Grid>
                                       </DataTemplate>
                                   </ListView.ItemTemplate>
                               </ListView>
                               <StackPanel Orientation="Horizontal" Spacing="8">
                                   <Button Content="添加应用…" Click="AddBinding_Click"/>
                                   <Button x:Name="PickForegroundButton" Content="用当前前台应用添加" Click="PickForegroundButton_Click"/>
                               </StackPanel>
                               <TextBlock x:Name="PerAppStatus" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=""/>
                           </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 配置文件与快捷键 ============ -->
            <Border Grid.Row="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="24,0,24,16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" Height="18" CornerRadius="2" VerticalAlignment="Center"
                                Background="#B060E0"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="配置与快捷键" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="保存多套滤镜配置，快速切换并绑定全局快捷键。"
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <ListView x:Name="ProfileList" Height="104" SelectionMode="Single"
                             SelectionChanged="ProfileList_SelectionChanged">
                        <ListView.ItemTemplate>
                           <DataTemplate>
                               <Grid ColumnSpacing="10">
                                   <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*"/>
                                       <ColumnDefinition Width="Auto"/>
                                   </Grid.ColumnDefinitions>
                                   <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                   <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                           CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                       <TextBlock Text="{Binding HotkeyDisplay}" FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                   </Border>
                               </Grid>
                           </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="新建配置" Click="NewProfile_Click"/>
                        <Button Content="更新所选" Click="UpdateProfile_Click"/>
                        <Button Content="应用所选" Click="ApplyProfile_Click"/>
                        <Button Content="删除配置" Click="DeleteProfile_Click"/>
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/>
                           <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="所选配置快捷键" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                           <Button Content="设置快捷键…" Click="CaptureHotkey_Click"/>
                           <Button Content="清除" Click="ClearHotkey_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="全局开关快捷键" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                           <Button Content="设置快捷键…" Click="CaptureGlobalHotkey_Click"/>
                           <Button Content="清除" Click="ClearGlobalHotkey_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="CaptureHint" FontSize="12"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Text=""/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="界面主题" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeComboBox" MinWidth="150" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="默认主题" Tag="default"/>
                            <ComboBoxItem Content="Mica 主题" Tag="mica"/>
                        </ComboBox>
                    </StackPanel>

                    <ToggleSwitch x:Name="CaptureSwitch" Header="UI 与滤镜层可被 OBS 捕获"
                                  OnContent="可捕获" OffContent="排除捕获" Toggled="CaptureSwitch_Toggled"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="开启后可被 OBS 等屏幕捕获：OBS 请用「显示器捕获（WGC 模式）」即可同时录到滤镜效果与 UI；不要用「窗口捕获」（WinUI 窗口 / 覆盖层用窗口捕获会黑屏或选不到）。"/>

                    <ToggleSwitch x:Name="AutoStartSwitch" Header="开机自动启动" Toggled="AutoStartSwitch_Toggled"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
