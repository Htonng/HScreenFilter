<Window
    x:Class="HScreenFilter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HScreenFilter.Controls"
    Title="屏幕滤镜">

    <!-- 整页滚动：窗口较小时可上下滚动查看全部内容（滑块 + 配置 + 开机自启） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ZoomMode="Disabled">
        <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown" IsTabStop="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 头部 ============ -->
            <Border Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="24,16,24,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="HScreenFilter" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="StatusText" FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Text="正在初始化…"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="EnableSwitch" Header="启用滤镜"
                                     OnContent="已启用" OffContent="已关闭"
                                     Toggled="EnableSwitch_Toggled" Margin="0,4,0,0"/>
                        <Border x:Name="GlobalHotkeyBadge" Grid.Column="1"
                               Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                               CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Visibility="Collapsed">
                           <StackPanel Orientation="Horizontal" Spacing="6">
                               <TextBlock Text="全局开关" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                               <TextBlock x:Name="GlobalHotkeyText" FontSize="11" FontWeight="SemiBold"/>
                           </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 滑块与预设 ============ -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="24,4,24,8" Spacing="12">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,16"
                                Margin="0,0,0,12">
                           <StackPanel Spacing="12">
                               <StackPanel Spacing="4">
                                   <TextBlock Text="基础调节" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                   <TextBlock Text="拖动滑块即可实时调整滤镜的亮度、对比度、色彩和阴影表现。"
                                              FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                               </StackPanel>
                               <StackPanel Spacing="12">
                                   <controls:FilterSlider x:Name="BrightnessSlider" Header="亮度 Brightness" Minimum="-100" Maximum="100"/>
                                   <controls:FilterSlider x:Name="ContrastSlider" Header="对比度 Contrast" Minimum="0" Maximum="200"/>
                                   <controls:FilterSlider x:Name="SaturationSlider" Header="鲜艳度 Saturation" Minimum="0" Maximum="200"/>
                                   <controls:FilterSlider x:Name="HighlightSlider" Header="亮部 Highlights" Minimum="-100" Maximum="100"/>
                                   <controls:FilterSlider x:Name="ShadowSlider" Header="暗部 Shadows" Minimum="-100" Maximum="100"/>
                                   <controls:FilterSlider x:Name="TemperatureSlider" Header="色温（冷 ← → 暖）" Minimum="-100" Maximum="100"/>
                               </StackPanel>

                               <StackPanel Spacing="8">
                                   <TextBlock Text="快捷预设" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                   <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Button Content="标准" Click="PresetStandard_Click"/>
                                       <Button Content="护眼" Click="PresetEyeCare_Click"/>
                                       <Button Content="夜间" Click="PresetNight_Click"/>
                                       <Button Content="鲜艳" Click="PresetVivid_Click"/>
                                   </StackPanel>
                               </StackPanel>
                           </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,16"
                                Margin="0,0,0,12">
                           <StackPanel Spacing="12">
                               <StackPanel Spacing="4">
                                   <TextBlock Text="HSL 调色盘" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                   <TextBlock Text="像 Photoshop 一样按色相、饱和度、明度精确调整整体色彩。" 
                                              FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                               </StackPanel>
                               <StackPanel Spacing="12">
                                   <controls:FilterSlider x:Name="HueSlider" Header="色相 Hue" Minimum="-180" Maximum="180"
                                                          Spectrum="#FF0000,#FFFF00,#00FF00,#00FFFF,#0000FF,#FF00FF,#FF0000"/>
                                   <controls:FilterSlider x:Name="HslSaturationSlider" Header="饱和度 Saturation" Minimum="0" Maximum="200"
                                                          Spectrum="#808080,#FF0000"/>
                                   <controls:FilterSlider x:Name="LightnessSlider" Header="明度 Lightness" Minimum="-100" Maximum="100"
                                                          Spectrum="#000000,#808080,#FFFFFF"/>
                               </StackPanel>
                           </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,16"
                                Margin="0,0,0,12">
                           <StackPanel Spacing="10">
                               <StackPanel Spacing="4">
                                   <TextBlock Text="按应用切换滤镜" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                   <TextBlock Text="让滤镜只在指定应用前台时启用，切到其它窗口时自动关闭。"
                                              FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                               </StackPanel>
                               <ToggleSwitch x:Name="PerAppSwitch" Header="启用按应用切换"
                                             OnContent="已启用" OffContent="已关闭"
                                             Toggled="PerAppSwitch_Toggled"/>
                               <Grid ColumnSpacing="8">
                                   <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="Auto"/>
                                       <ColumnDefinition Width="*"/>
                                   </Grid.ColumnDefinitions>
                                   <Grid.RowDefinitions>
                                       <RowDefinition Height="Auto"/>
                                       <RowDefinition Height="Auto"/>
                                   </Grid.RowDefinitions>
                                   <TextBlock Grid.Row="0" Grid.Column="0" Text="进程名" VerticalAlignment="Center"/>
                                   <TextBox Grid.Row="0" Grid.Column="1" x:Name="PerAppProcessBox"
                                            PlaceholderText="例如 notepad 或 chrome" TextChanged="PerAppProcessBox_TextChanged"/>
                                   <TextBlock Grid.Row="1" Grid.Column="0" Text="窗口标题" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                   <TextBox Grid.Row="1" Grid.Column="1" x:Name="PerAppTitleBox"
                                            PlaceholderText="标题包含的文字（可选，如 notepad 可不填）" TextChanged="PerAppTitleBox_TextChanged"/>
                               </Grid>
                               <Button x:Name="PickForegroundButton" Content="选择当前前台应用" Click="PickForegroundButton_Click"/>
                               <TextBlock x:Name="PerAppStatus" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=""/>
                           </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 配置文件与快捷键 ============ -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="24,0,24,16">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="配置与快捷键" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="保存多套滤镜配置，快速切换并绑定全局快捷键。"
                                  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ListView x:Name="ProfileList" Height="104" SelectionMode="Single"
                             SelectionChanged="ProfileList_SelectionChanged">
                        <ListView.ItemTemplate>
                           <DataTemplate>
                               <Grid ColumnSpacing="10">
                                   <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*"/>
                                       <ColumnDefinition Width="Auto"/>
                                   </Grid.ColumnDefinitions>
                                   <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                   <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                           CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                       <TextBlock Text="{Binding HotkeyDisplay}" FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                   </Border>
                               </Grid>
                           </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="新建配置" Click="NewProfile_Click"/>
                        <Button Content="更新所选" Click="UpdateProfile_Click"/>
                        <Button Content="应用所选" Click="ApplyProfile_Click"/>
                        <Button Content="删除配置" Click="DeleteProfile_Click"/>
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/>
                           <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="所选配置快捷键" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                           <Button Content="设置快捷键…" Click="CaptureHotkey_Click"/>
                           <Button Content="清除" Click="ClearHotkey_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="全局开关快捷键" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                           <Button Content="设置快捷键…" Click="CaptureGlobalHotkey_Click"/>
                           <Button Content="清除" Click="ClearGlobalHotkey_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="CaptureHint" FontSize="12"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Text=""/>

                    <ToggleSwitch x:Name="AutoStartSwitch" Header="开机自动启动" Toggled="AutoStartSwitch_Toggled"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
