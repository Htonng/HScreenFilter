<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标 Windows SDK 升级到 26100（Windows 11 24H2），以获得 GraphicsCaptureItem.CreateForMonitor 等现代 API；
         最低系统版本仍是 10.0.17763（Windows 10 1809），不会提高运行门槛。 -->
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>HScreenFilter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 使用自定义 Program.Main（便于捕获并记录启动异常） -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- DXGI Desktop Duplication 桌面捕获（替代 Windows.Graphics.Capture，
         避免 Windows 11 屏幕捕获隐私边框）。 -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把图标等资源复制到输出目录，供窗口/任务栏/托盘图标在运行时加载 -->
    <None Include="assets\icon.ico" Link="assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
