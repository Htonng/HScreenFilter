<UserControl
    x:Class="HScreenFilter.Controls.FilterSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{x:Bind Header}" VerticalAlignment="Center" TextWrapping="Wrap"/>

        <Grid Grid.Column="1">
            <!-- 彩色渐变轨道：Photoshop 式颜色滑块（无 Spectrum 时隐藏）
                 仅在有 Spectrum 时由代码把默认轨道设为透明，露出渐变；否则保持默认轨道。 -->
            <Border x:Name="SpectrumBar"
                    Height="8" CornerRadius="4"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
            <Slider x:Name="Slider"
                    VerticalAlignment="Center"
                    Minimum="{x:Bind Minimum}"
                    Maximum="{x:Bind Maximum}"
                    StepFrequency="1"
                    SnapsTo="StepValues"
                    ValueChanged="Slider_ValueChanged"/>
        </Grid>

        <TextBox x:Name="ValueText"
                 Grid.Column="2"
                 Text="0"
                 TextAlignment="Right"
                 VerticalAlignment="Center"
                 Width="52"
                 Padding="4,2"
                 FontSize="12"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 KeyDown="ValueText_KeyDown"
                 LostFocus="ValueText_LostFocus"/>
    </Grid>
</UserControl>
